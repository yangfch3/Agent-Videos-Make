# 临时文件（草稿、日志、中间态）
Temp/

# 本机 IDE 工作区
*.code-workspace

# 各项目指向框架 shared/、系列 common/ 的目录联接（tools/link-shared.cmd 创建）
**/assets/shared
**/assets/series

# 依赖
node_modules/
.venv/
__pycache__/

# 渲染与生成产物（可由源码重建，不入库）；外来素材视频、图片不在此列，走 LFS 入库
renders/
.debug/
.hyperframes/
.transcode-cache/
projects/**/assets/gen/
projects/**/assets/sfx/*.wav
projects/**/assets/bgm/*.wav
# Manim 默认输出目录（应改用 --media_dir Temp/...，这里兜底）
/media/
